# ---------------------------------------------------------------------------
# RazorReclaim — environment variables
# Copy to `.env.local` for local dev, or paste into Vercel → Project Settings
# → Environment Variables for a deployment. Nothing here has a default that
# reaches a live account; every integration is test/sandbox mode.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project URL + keys from Supabase → Project Settings → API.
# The service role key is server-only. Never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM provider (required) -----------------------------------------------
# "ollama" runs a local model (free, ~90s/call — fine for development).
# "gemini" is the cloud path and the only one that works on Vercel, since
# there is no local Ollama on a serverless host.
LLM_PROVIDER=gemini

# Local-only. Ignored when LLM_PROVIDER=gemini.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Gemini free tier caps at 15 RPM, which is too slow for a 25-30 case batch.
# Enable billing on the backing Google Cloud project for a usable rate limit,
# and set a Budget & Alert (Cloud Console → Billing → Budgets) as a safety net.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Razorpay (required for real payment links) ----------------------------
# TEST MODE keys only (rzp_test_...). The agent creates real Payment Links
# against the test account; no real money moves.
# The webhook secret is set when you register the webhook endpoint at
# Razorpay → Settings → Webhooks → <your-url>/api/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Resend (required for real recovery emails) ----------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Resend's sandbox domain only delivers to one verified address. Until you
# verify a custom domain, every send is routed here regardless of the case's
# own (plus-addressed) customer_email. Defaults to DEMO_EMAIL_BASE.
RESEND_SANDBOX_RECIPIENT=

# --- ElevenLabs (optional — enables real voice-recovery audio) --------------
# Without a key, the voice action still runs and still writes its script and
# outcome; it just has no audio attached. With a key, the exact script the
# agent wrote is synthesised and playable on the case page.
ELEVENLABS_API_KEY=
# Leave blank to use the built-in multilingual voice.
ELEVENLABS_VOICE_ID=
# "english" | "hindi" | "hinglish" — defaults to hinglish.
VOICE_LANGUAGE=hinglish

# --- Synthetic demo data ---------------------------------------------------
# Generated customer emails are plus-addressed off this base, so every
# demo email lands in one real inbox you control.
DEMO_EMAIL_BASE=
DEMO_EMAIL_POOL_SIZE=10
