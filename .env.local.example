# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider — "ollama" (local, default) or "gemini" (cloud fallback)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Gemini kept as a swappable secondary/cloud provider (see src/lib/ai/provider.ts)
# Free tier caps at 15 RPM (too slow for a live 150-200 case batch) — enable
# billing on the backing Google Cloud project for ~4000 RPM. Set a Budget &
# Alert in Cloud Console — Billing → Budgets as a safety net.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Razorpay (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Synthetic demo data — customer emails route here via plus-addressing
DEMO_EMAIL_BASE=
DEMO_EMAIL_POOL_SIZE=10
